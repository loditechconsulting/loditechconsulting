# Copy to .env.local (or set these in your hosting provider) and fill in.

# Public URL of the site, no trailing slash. Enables canonical URLs, Open Graph
# images, structured-data URLs, robots.txt sitemap line and sitemap.xml.
VITE_SITE_URL=

# Where the consultation form posts (JSON). Works with, for example:
#   Web3Forms  -> VITE_FORM_ENDPOINT=https://api.web3forms.com/submit  + VITE_FORM_ACCESS_KEY
#   Formspree  -> VITE_FORM_ENDPOINT=https://formspree.io/f/<form-id>
# If left empty, the form falls back to opening the visitor's email app.
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
